{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.worker",
    "watchPatterns": [
      "src/whatsapp_langchain/worker/**",
      "src/whatsapp_langchain/agents/**",
      "src/whatsapp_langchain/shared/**",
      "pyproject.toml",
      "uv.lock",
      "Dockerfile.worker"
    ]
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
