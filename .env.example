# Configuração de desenvolvimento. Copie para .env e preencha.
# NUNCA versione o .env — ele contém segredos.

# --- Banco ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whatsapp_langchain

# --- Runtime ---
ENVIRONMENT=development
PORT=8000
LOG_LEVEL=info
LOG_JSON=false

# --- Outbound ---
# mock em dev, real em produção. Em modo real, um canal "tocado parcialmente"
# (algumas credenciais preenchidas e outras não) derruba o boot.
OUTBOUND_MODE=mock

# --- Twilio ---
VALIDATE_TWILIO_SIGNATURE=false
TWILIO_AUTH_TOKEN=
TWILIO_WEBHOOK_URL=
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_FROM_NUMBER=

# --- Meta WhatsApp Cloud API ---
META_VALIDATE_SIGNATURE=true
META_VERIFY_TOKEN=
META_APP_SECRET=
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v23.0

# --- uazapi ---
UAZAPI_BASE_URL=
UAZAPI_INSTANCE_TOKEN=

# --- Evolution API ---
# As TRÊS variáveis abaixo andam juntas. Preencher só algumas derruba o boot
# em OUTBOUND_MODE=real; deixar todas vazias desabilita o canal — e nesse caso
# o webhook inbound continua aceitando mensagens, que morrem no worker uma a
# uma. Ver docs/EVOLUTION.md.
EVOLUTION_BASE_URL=https://evolution.exemplo.host
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# Opcional em dev; obrigatória em ENVIRONMENT=production com o canal
# configurado (o boot falha se vazia ou com menos de 32 caracteres). Quando
# preenchida, a rota /webhook/evolution exige este valor no header.
# NÃO reutilize o valor de EVOLUTION_API_KEY aqui.
EVOLUTION_WEBHOOK_SECRET=

# --- Google Calendar (agenda onde o agente SDR marca as consultorias) ---
# OAuth 2.0 de aplicação instalada: o refresh token é permanente e vem da
# autorização de uma conta com escrita na agenda. GOOGLE_CALENDAR_ID é o
# e-mail do calendário (ex: fulano@empresa.com).
# ATENÇÃO: rotacionar o OAuth Client no Google Cloud Console invalida o
# refresh token e derruba o agendamento até alguém reautorizar.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=

# --- Pipedrive (funil comercial do agente SDR) ---
# `update_crm` move o card do lead ao mudar de fase. Os stage_id abaixo são
# do pipeline comercial; `desqualificado` não move card por definição.
# OPCIONAL, e é o único do agente SDR que é: sem PIPEDRIVE_API_TOKEN a fase
# continua sendo gravada no banco, o card não se move e fica
# `crm_pipedrive_nao_configurado` no log. Rodar sem Pipedrive (staging sem
# sandbox de CRM, por exemplo) é escolha suportada.
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_STAGE_QUALIFICADO=12
PIPEDRIVE_STAGE_AGENDADO=13

# --- Handover para humano ---
# Número que recebe o aviso quando `human_handover` desliga o agente
# (E.164 ou só dígitos — "11 97777-6666" também serve, é canonicalizado).
# O aviso sai pelo mesmo canal Evolution acima.
# OBRIGATÓRIO junto com as quatro GOOGLE_* acima: em OUTBOUND_MODE=real, se
# qualquer uma das cinco estiver preenchida, TODAS precisam estar — senão a
# API e o Worker não sobem. Vazio, `human_handover` desligaria o agente sem
# avisar ninguém, e o lead ficaria em silêncio esperando um humano que nunca
# foi acionado. Em OUTBOUND_MODE=mock (o default em dev) nada é exigido.
HANDOVER_NOTIFY_PHONE=

# --- Limites de entrada ---
RATE_LIMIT_PER_HOUR=30
MESSAGE_BUFFER_SECONDS=2.0

# --- LLM (OpenRouter) ---
# PARIDADE elevec_sdr: o n8n rodava a Renata em `x-ai/grok-4.3` (evidência em
# docs/evidencias/prompt-renata-n8n.md). O default abaixo é o do harness,
# compartilhado com illumi_assistant e rhawk_assistant — NÃO é o modelo da
# Renata. Deploy que atende leads da EleveC precisa setar
# OPENROUTER_MODEL=x-ai/grok-4.3 explicitamente; sem isso ela roda num
# modelo diferente do que foi validado com o SOP em produção.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=x-ai/grok-4.1-fast
OPENROUTER_MIDIA_MODEL=google/gemini-2.5-flash-lite
LLM_RATE_LIMIT_REQUESTS_PER_SECOND=0.5
LLM_RATE_LIMIT_MAX_BURST=10

# --- Worker ---
POLL_INTERVAL_SECONDS=1.0
LEASE_SECONDS=60
MAX_ATTEMPTS=3

# --- Allowlist (janela de teste em produção) ---
# Trava OPOSTA à blocklist: preenchida, SÓ estes telefones são atendidos —
# o resto é descartado no gate e na régua, antes de qualquer escrita. Vazia
# = desligada (todo mundo passa). Separada por vírgula; aceita +, espaço,
# hífen e JID do WhatsApp. ESVAZIE ao fim da janela de teste.
ALLOWLIST_PHONES=

# --- Follow-up (régua de reengajamento, hoje só elevec_sdr) ---
# Desligada por padrão, deliberadamente — fica false até o cutover. Ligar
# antes disso faz a régua rodar de verdade contra leads reais sem que o
# resto da migração (webhook do ChatWoot, mapa de template por origem) esteja
# pronto para sustentar o que ela dispara. Ver worker/followup.py.
FOLLOWUP_ENABLED=false
# Intervalo entre rodadas do loop assíncrono no Worker, e tamanho do lote
# (LIMIT) reivindicado por rodada.
FOLLOWUP_INTERVAL_SECONDS=300
FOLLOWUP_BATCH_SIZE=10
# Os três degraus contam a partir de last_inbound_at — a última mensagem DO
# LEAD —, não do envio anterior. Isso os torna absolutos: os até 5 minutos de
# atraso de cada rodada não se acumulam. Ancorar em last_interaction_at (como
# fazia o n8n) empurrava o degrau 3 para ~24h28 desde a criação do lead, fora
# da janela de 24h da Cloud API, e a Meta rejeita em vez de atrasar.
FOLLOWUP_NIVEL1_MINUTOS=15
FOLLOWUP_NIVEL2_MINUTOS=75
FOLLOWUP_NIVEL3_MINUTOS=1380
# Folga antes das 24h da janela da Cloud API: um lead só é reivindicado se
# last_inbound_at ainda estiver dentro de (24h - esta margem). Sem folga, o
# tempo entre reivindicar e o HTTP de fato sair poderia cruzar o corte exato.
FOLLOWUP_JANELA_MARGEM_MINUTOS=30

# --- Balões (resposta em múltiplas mensagens, hoje só elevec_sdr) ---
BALAO_DELAY_MS=700
BALAO_MAX_COUNT=10

MEDIA_IMAGE_ENABLED=true
MEDIA_AUDIO_ENABLED=true

# --- Contexto do agente ---
# PARIDADE elevec_sdr: a Postgres Chat Memory do n8n mantinha janela de
# **12 mensagens**. Aqui a janela é `TRIM_KEEP_TURNS` (turnos, não
# mensagens) com CONTEXT_STRATEGY=trim, ou `SUMMARIZE_KEEP_MESSAGES` com
# CONTEXT_STRATEGY=summarize. Os 5 turnos abaixo são o default do harness e
# guardam MENOS histórico que o n8n — num SOP de 8 fases isso é a diferença
# entre lembrar e não lembrar que o faturamento já foi coletado. Ajuste
# conscientemente antes do cutover.
CONTEXT_STRATEGY=trim
TRIM_KEEP_TURNS=5
SUMMARIZE_TRIGGER_TOKENS=4000
SUMMARIZE_KEEP_MESSAGES=10
SUMMARIZE_MODEL=x-ai/grok-4.1-fast

# --- Memória semântica ---
MEMORY_ENABLED=true
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMS=1536
MEMORY_SEARCH_LIMIT=5

# --- Admin ---
# Compartilhado entre API e frontend. Gere com: openssl rand -base64 32
INTERNAL_SERVICE_TOKEN=

# --- ChatWoot (etiqueta pausar_agente = handover humano) ---
# Vazio = rota aberta (dev). Em produção, 32+ caracteres.
CHATWOOT_WEBHOOK_SECRET=

# --- Horário comercial (a Renata cala; quem atende é gente) ---
# Dentro da janela, seg-sex, o gate DESCARTA a mensagem: o time responde pelo
# ChatWoot. A Renata cobre noite, madrugada e fim de semana. Fuso
# America/Sao_Paulo. Início inclusivo, fim exclusivo (8 e 18 = 8h00 às 17h59).
# inicio == fim desliga, e é esse o default: o template é herdado por outros
# clientes, e uma janela ligada sozinha emudeceria a IA deles no dia útil.
HORARIO_COMERCIAL_INICIO=0
HORARIO_COMERCIAL_FIM=0
