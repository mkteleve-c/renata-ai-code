{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.frontend",
    "watchPatterns": [
      "frontend/**",
      "Dockerfile.frontend"
    ]
  },
  "deploy": {
    "numReplicas": 1,
    "healthcheckPath": "/login",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
