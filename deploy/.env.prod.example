# ============================================================
# Produção — Variáveis para docker-compose.prod.yml + Traefik
# ============================================================
# Copie para .env.prod e preencha:
#   cp .env.prod.example .env.prod
#
# NUNCA commite .env.prod (já está no .gitignore do projeto).
# Gere segredos fortes com: openssl rand -base64 32

# === Domínio público desta instância ====================================
# Subdomínio que aponta para o IP desta VPS (registro A no DNS).
# Será o endpoint do webhook Twilio/Meta e a URL do painel admin.
# Exemplo: cliente1.vps.illumiai.com
DOMAIN=

# E-mail para Let's Encrypt (alertas de expiração de certificado).
LETSENCRYPT_EMAIL=

# Nível de log do Traefik (DEBUG, INFO, WARN, ERROR).
TRAEFIK_LOG_LEVEL=INFO

# === PostgreSQL ==========================================================
POSTGRES_DB=whatsapp_langchain
POSTGRES_USER=postgres
# IMPORTANTE: gere em HEX (sem '/', '=' ou '+') porque a senha é embutida
# em DATABASE_URL e PGWEB_DATABASE_URL — esses caracteres são reservados em
# URL e quebram o parser do psycopg/pgweb (host vira inválido, pgweb crasha
# com 'Invalid URL' e a API tenta resolver host literal 'postgres').
# Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=

# === pgweb (visualizador web do Postgres em /banco) ======================
# Acesse em https://${DOMAIN}/banco — protegido por BasicAuth.
# A porta 5432 NÃO é exposta publicamente; pgweb conecta via rede Docker.
# Para acesso direto pontual (DBeaver), use SSH tunnel:
#   ssh -L 5432:localhost:5432 user@vps   (com a porta bindada em 127.0.0.1:5432
#   adicionada manualmente ao compose, se necessário).
PGWEB_AUTH_USER=admin
# Gere uma senha forte: openssl rand -base64 24
PGWEB_AUTH_PASS=

# === Messaging channel (multi-canal automático) ==========================
# O canal de cada mensagem é decidido pelo webhook inbound que a recebeu e
# persistido em message_queue.channel. O worker mantém clientes outbound de
# todos os canais habilitados (com credenciais preenchidas abaixo) e seleciona
# o cliente certo pelo channel da mensagem ao responder.
#
# Para habilitar um canal: preencha suas credenciais. Para desabilitar: deixe
# todas as credenciais do canal vazias. Em OUTBOUND_MODE=real, um canal
# parcialmente configurado faz o worker falhar no boot (fail-fast).

# === Outbound mode =======================================================
# 'real' envia mensagens de verdade. Em produção, sempre 'real'.
OUTBOUND_MODE=real

# === LLM (OpenRouter) ====================================================
# PARIDADE elevec_sdr: o n8n rodava a Renata em `x-ai/grok-4.3`. O valor
# abaixo é o default do harness (vale para illumi/rhawk também). Deploy da
# EleveC: troque para x-ai/grok-4.3 antes do cutover — o SOP foi validado
# naquele modelo, não neste.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=x-ai/grok-4.1-fast
OPENROUTER_MIDIA_MODEL=google/gemini-2.5-flash-lite

# === Meta WhatsApp Cloud API =============================================
# Habilite preenchendo as credenciais abaixo. Deixe todas vazias para desabilitar.

# Inbound (handshake + validação X-Hub-Signature-256):
# Token que você define — cadastre o mesmo valor no painel do Meta no campo
# "Verify token" da configuração do webhook.
# Gere com: openssl rand -hex 32
META_VERIFY_TOKEN=
# App Secret (Meta App → Settings → Basic → "App Secret").
META_APP_SECRET=
# Validação da assinatura — true em produção.
META_VALIDATE_SIGNATURE=true

# Outbound (Graph API):
# Phone Number ID (WhatsApp Business → API Setup → "Phone number ID").
META_PHONE_NUMBER_ID=
# System User Access Token PERMANENTE com permissão whatsapp_business_messaging.
# Business Settings → System Users → Generate New Token.
META_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v23.0

# === Twilio ==============================================================
# Habilite preenchendo as 4 credenciais abaixo. Deixe todas vazias para desabilitar.
TWILIO_OUTBOUND_MODE=
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_FROM_NUMBER=
VALIDATE_TWILIO_SIGNATURE=false
TWILIO_AUTH_TOKEN=

# === uazapi (uazapiGO baseada em Baileys) ================================
# Habilite preenchendo UAZAPI_BASE_URL. Deixe vazio para desabilitar.
# URL base do subdomínio da instância. Obrigatório.
# Ex: https://meucliente.uazapi.com
UAZAPI_BASE_URL=
# Fallback estático opcional — o token da instância vem no payload do webhook
# e é persistido por mensagem em message_queue.outbound_token. Preencha aqui
# só se quiser um valor padrão para casos onde o webhook não traz o token.
UAZAPI_INSTANCE_TOKEN=

# === Tokens internos (gerar fortes — 32+ chars) ==========================
# Gere ambos com: openssl rand -base64 32
INTERNAL_SERVICE_TOKEN=
BETTER_AUTH_SECRET=

# === Bootstrap do primeiro admin =========================================
# Usado no primeiro acesso ao /login se a tabela auth.user estiver vazia.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# === Rate limiting e debounce ============================================
RATE_LIMIT_PER_HOUR=30
MESSAGE_BUFFER_SECONDS=2.0

# === LLM rate limit ======================================================
LLM_RATE_LIMIT_REQUESTS_PER_SECOND=0.5
LLM_RATE_LIMIT_MAX_BURST=10

# === Worker ==============================================================
POLL_INTERVAL_SECONDS=1.0
LEASE_SECONDS=60
MAX_ATTEMPTS=3

# === Follow-up (régua de reengajamento, hoje só elevec_sdr) =============
# Desligada por padrão, deliberadamente — fica false até o cutover. Ligar
# antes disso faz a régua rodar de verdade contra leads reais sem que o
# resto da migração (webhook do ChatWoot, mapa de template por origem) esteja
# pronto para sustentar o que ela dispara. Ver worker/followup.py.
FOLLOWUP_ENABLED=false
# Intervalo entre rodadas do loop assíncrono no Worker, e tamanho do lote
# (LIMIT) reivindicado por rodada.
FOLLOWUP_INTERVAL_SECONDS=300
FOLLOWUP_BATCH_SIZE=10
# Os três degraus contam a partir de last_inbound_at — a última mensagem DO
# LEAD —, não do envio anterior. Isso os torna absolutos: os até 5 minutos de
# atraso de cada rodada não se acumulam. Ancorar em last_interaction_at (como
# fazia o n8n) empurrava o degrau 3 para ~24h28 desde a criação do lead, fora
# da janela de 24h da Cloud API, e a Meta rejeita em vez de atrasar.
FOLLOWUP_NIVEL1_MINUTOS=15
FOLLOWUP_NIVEL2_MINUTOS=75
FOLLOWUP_NIVEL3_MINUTOS=1380
# Folga antes das 24h da janela da Cloud API: um lead só é reivindicado se
# last_inbound_at ainda estiver dentro de (24h - esta margem). Sem folga, o
# tempo entre reivindicar e o HTTP de fato sair poderia cruzar o corte exato.
FOLLOWUP_JANELA_MARGEM_MINUTOS=30

# === Balões (resposta em múltiplas mensagens, hoje só elevec_sdr) =======
BALAO_DELAY_MS=700
BALAO_MAX_COUNT=10

# === Mídia ===============================================================
MEDIA_IMAGE_ENABLED=true
MEDIA_AUDIO_ENABLED=true

# === Contexto ============================================================
# PARIDADE elevec_sdr: o n8n mantinha janela de 12 MENSAGENS. Com
# CONTEXT_STRATEGY=summarize quem manda é SUMMARIZE_KEEP_MESSAGES (10
# abaixo, menos que as 12 do n8n); TRIM_KEEP_TURNS só vale se a estratégia
# for `trim`. Guardar menos histórico que a origem, num SOP de 8 fases em
# que e-mail e faturamento são coletados em turnos distintos, é risco de a
# Renata reperguntar o que o lead já respondeu.
# trim | summarize | none
CONTEXT_STRATEGY=summarize
TRIM_KEEP_TURNS=5
SUMMARIZE_TRIGGER_TOKENS=4000
SUMMARIZE_KEEP_MESSAGES=10
SUMMARIZE_MODEL=x-ai/grok-4.1-fast

# === Memória semântica ===================================================
MEMORY_ENABLED=true
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMS=1536
MEMORY_SEARCH_LIMIT=5

# === Logs ================================================================
LOG_LEVEL=info
LOG_JSON=true

# --- Evolution API (integração WHATSAPP-BUSINESS: Cloud API oficial por baixo) ---
# As TRÊS variáveis abaixo andam juntas. Preencher só algumas derruba o boot;
# deixar todas vazias desabilita o canal, mas o webhook inbound continua
# aceitando mensagens que morrerão no worker. Ver docs/EVOLUTION.md.
EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# OBRIGATÓRIA quando o canal Evolution está configurado: o boot em produção
# falha se estiver vazia ou com menos de 32 caracteres. Sem ela a rota
# /webhook/evolution aceita qualquer POST — texto arbitrário e remoteJid à
# escolha do atacante viram mensagem saindo pelo SEU número oficial Meta.
# Gere com: openssl rand -base64 32
# NÃO reutilize o valor de EVOLUTION_API_KEY aqui.
EVOLUTION_WEBHOOK_SECRET=

# === Google Calendar =====================================================
# Agenda onde o agente SDR marca as consultorias. OAuth 2.0 de aplicação
# instalada: o refresh token é permanente e vem da autorização de uma conta
# com permissão de escrita no calendário.
# GOOGLE_CALENDAR_ID é o e-mail do calendário (ex: fulano@empresa.com).
# ATENÇÃO: rotacionar o OAuth Client no Google Cloud Console invalida o
# refresh token — o agendamento para até alguém reautorizar e atualizar
# GOOGLE_REFRESH_TOKEN aqui.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=

# === Pipedrive ===========================================================
# Funil comercial. `update_crm` move o card do lead quando a fase muda:
# `qualificado` -> PIPEDRIVE_STAGE_QUALIFICADO, `agendou_sessao` ->
# PIPEDRIVE_STAGE_AGENDADO. `desqualificado` NÃO move card por definição —
# o funil não tem estágio de descarte.
# ATENÇÃO: este é o CRM de produção. Confira os stage_id contra o pipeline
# real antes de subir; um id errado move cards de verdade para o lugar
# errado.
# OPCIONAL — é o único do agente SDR que não entra no fail-fast de boot.
# Token vazio não derruba nada: a fase continua sendo gravada no banco (é
# ela que alimenta a régua de follow-up e o gate de ingestão), o card não se
# move e fica `crm_pipedrive_nao_configurado` no log. É o que permite subir
# staging em modo real sem sandbox de CRM.
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_STAGE_QUALIFICADO=12
PIPEDRIVE_STAGE_AGENDADO=13

# === Handover para humano ================================================
# Número que recebe o aviso quando `human_handover` desliga o agente para um
# lead (E.164 ou só dígitos — "11 97777-6666" também serve, é
# canonicalizado). O aviso sai pelo canal Evolution configurado acima e leva
# o motivo e o link wa.me do lead.
# OBRIGATÓRIO em modo real, junto com as quatro GOOGLE_* acima: as cinco
# formam um grupo só. Preencheu uma, preencha todas — senão a API e o Worker
# falham no boot com a lista do que falta. Deploys que não usam o agente
# elevec_sdr não preenchem nenhuma e sobem normalmente.
# O motivo de ser boot e não checklist: vazio, `human_handover` desligaria o
# agente sem avisar ninguém. O lead fica em silêncio esperando um humano que
# nunca foi acionado, e o único sinal seria uma frase que só o modelo lê.
# Valor preenchido mas irreconhecível ("ramal 42") também derruba o boot —
# ele passaria em qualquer checagem de "está configurado" e só falharia na
# hora do envio, com ninguém suspeitando da configuração.
HANDOVER_NOTIFY_PHONE=
